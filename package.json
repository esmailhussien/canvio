{
  "name": "canvio",
  "version": "0.1.0",
  "private": true,
  "description": "A connected whiteboard for thinking, learning, planning, and research — with maps, AI, and relations built in when your ideas need them.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test:unit": "tsx scripts/unit/run-unit-tests.ts",
    "test:stress": "tsx scripts/stress-websocket.ts",
    "smoke": "node scripts/smoke-check.mjs",
    "benchmark:canvas": "node scripts/benchmark-canvas.mjs",
    "e2e:smoke": "npm run build && node scripts/e2e-smoke.mjs",
    "og": "node scripts/generate-og-image.mjs",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "tsx": "^4.20.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "npm@11.9.0"
}
