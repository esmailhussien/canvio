# Primary AI Provider (groq | gemini | openai | anthropic)
CANVIO_AI_PROVIDER=groq
CANVIO_GROQ_MODEL=llama-3.3-70b-versatile
CANVIO_GROQ_API_KEY=gsk_your_groq_api_key_here

# Fallback AI Provider (automatically used if primary fails, times out, or is rate-limited)
CANVIO_AI_FALLBACK_PROVIDER=gemini
CANVIO_GEMINI_MODEL=gemini-1.5-flash
CANVIO_GEMINI_API_KEY=your-gemini-key

# Production API protection.
CANVIO_ALLOWED_ORIGINS=https://canvio.space,https://www.canvio.space
CANVIO_ALLOW_LOCAL_ORIGINS=false
CANVIO_AI_RATE_LIMIT=10
CANVIO_AI_RATE_WINDOW_MS=60000

# Privacy-safe product events are written to structured server logs. Payloads
# are schema-validated and cannot include board text, prompts, URLs, or map data.
CANVIO_TELEMETRY_ENABLED=true
CANVIO_TELEMETRY_RATE_LIMIT=60
CANVIO_TELEMETRY_RATE_WINDOW_MS=60000

# Enable after the app has a real user/session token configured.
# CANVIO_REQUIRE_AI_AUTH=true
